APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# JWT Authentication Configuration
# JWT_TTL: Token time-to-live in minutes (default: 60 minutes)
# For call center applications, you can increase this for longer sessions
JWT_TTL=60

# JWT_REFRESH_TTL: How long tokens can be refreshed in minutes (default: 20160 = 2 weeks)
# This allows tokens to be refreshed within this window without re-authentication
JWT_REFRESH_TTL=20160

# JWT_AUTO_REFRESH_THRESHOLD: Auto-refresh threshold in seconds (default: 1800 = 30 minutes)
# Tokens will auto-refresh when they have less than this time remaining
# For call center use, 30 minutes ensures seamless session extension
JWT_AUTO_REFRESH_THRESHOLD=1800

# JWT_BLACKLIST_GRACE_PERIOD: Grace period in seconds for token blacklisting (default: 0)
# Useful for preventing issues with concurrent requests during token refresh
JWT_BLACKLIST_GRACE_PERIOD=10

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Broadcasting Configuration (for WebSocket)
BROADCAST_DRIVER=pusher
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_ID=
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

# Laravel Reverb (Alternative to Pusher)
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_APP_ID=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Mitel MiContact Center Configuration
MITEL_BASE_URL=https://your-mitel-server.com/miccsdk
MITEL_API_TOKEN=
MITEL_API_TIMEOUT=30

# Superset Embedded Dashboard Configuration
SUPERSET_URL=http://localhost:8088
SUPERSET_USERNAME=admin
SUPERSET_PASSWORD=admin

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_SUPERSET_URL=http://localhost:8088
